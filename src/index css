@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

@import 'tailwindcss';
@import 'tw-animate-css';

@plugin "@tailwindcss/typography";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));

  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-card-border: hsl(var(--card-border));

  --color-popover: hsl(var(--popover));
  --color-popover-foreground: hsl(var(--popover-foreground));
  --color-popover-border: hsl(var(--popover-border));

  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));

  --color-secondary: hsl(var(--secondary));
  --color-secondary-foreground: hsl(var(--secondary-foreground));

  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));

  --color-accent: hsl(var(--accent));
  --color-accent-foreground: hsl(var(--accent-foreground));

  --color-destructive: hsl(var(--destructive));
  --color-destructive-foreground: hsl(var(--destructive-foreground));

  --font-sans: var(--app-font-sans);
  --font-mono: var(--app-font-mono);

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

:root {
  --background: 43 30% 94%;
  --foreground: 218 34% 17%;
  --border: 38 18% 84%;
  --input: 38 18% 78%;
  --ring: 173 56% 38%;

  --card: 42 28% 97%;
  --card-foreground: 218 34% 17%;
  --card-border: 38 18% 84%;

  --sidebar: 216 37% 14%;
  --sidebar-foreground: 209 21% 86%;
  --sidebar-border: 215 27% 24%;
  --sidebar-accent: 215 29% 21%;

  --popover: 42 28% 97%;
  --popover-foreground: 218 34% 17%;
  --popover-border: 38 18% 84%;

  --primary: 173 56% 34%;
  --primary-foreground: 42 28% 97%;

  --secondary: 212 24% 89%;
  --secondary-foreground: 218 34% 20%;

  --muted: 40 19% 90%;
  --muted-foreground: 216 15% 45%;

  --accent: 38 87% 57%;
  --accent-foreground: 31 46% 17%;

  --destructive: 2 67% 46%;
  --destructive-foreground: 42 28% 97%;

  --app-font-sans: 'DM Sans', sans-serif;
  --app-font-mono: 'DM Mono', monospace;

  --radius: 0.65rem;
  --spacing: 0.25rem;
}

.dark {
  --background: 216 37% 11%;
  --foreground: 43 30% 94%;
  --border: 215 27% 24%;
  --input: 215 27% 30%;

  --card: 216 34% 15%;
  --card-foreground: 43 30% 94%;
  --card-border: 215 27% 24%;

  --popover: 216 34% 15%;
  --popover-foreground: 43 30% 94%;
  --popover-border: 215 27% 24%;

  --primary: 173 56% 47%;
  --primary-foreground: 216 37% 12%;

  --secondary: 215 29% 21%;
  --secondary-foreground: 43 30% 94%;

  --muted: 215 29% 21%;
  --muted-foreground: 211 16% 68%;

  --accent: 38 87% 57%;
  --accent-foreground: 31 46% 17%;

  --destructive: 2 67% 54%;
  --destructive-foreground: 42 28% 97%;

  --sidebar: 216 37% 9%;
  --sidebar-foreground: 209 21% 86%;
  --sidebar-border: 215 27% 19%;
  --sidebar-accent: 215 29% 17%;
}

@layer base {
  * {
    @apply border-border;
  }

  body {
    @apply font-sans antialiased bg-background text-foreground;
    margin: 0;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }
}

@layer utilities {
  .font-display {
    font-family: 'Space Grotesk', sans-serif;
  }

  .font-mono-data {
    font-family: 'DM Mono', monospace;
  }

  .bg-grid {
    background-image:
      linear-gradient(
        rgba(29, 55, 75, 0.045) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(29, 55, 75, 0.045) 1px,
        transparent 1px
      );
    background-size: 24px 24px;
  }

  .text-balance {
    text-wrap: balance;
  }

  .field-label {
    display: block;
    margin-bottom: 7px;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #687487;
  }
}

* {
  scrollbar-width: thin;
  scrollbar-color: hsl(var(--border)) transparent;
}

::selection {
  background: hsl(var(--accent) / 0.35);
}

.app-shell {
  min-height: 100dvh;
  display: flex;
  background: hsl(var(--background));
}

.sidebar {
  width: 248px;
  flex: 0 0 248px;
  background: hsl(var(--sidebar));
  color: hsl(var(--sidebar-foreground));
  display: flex;
  flex-direction: column;
  padding: 22px 14px 16px;
}

.main-area {
  min-width: 0;
  flex: 1;
}

.content-wrap {
  width: min(100%, 1420px);
  margin: 0 auto;
  padding: 32px clamp(20px, 3.4vw, 52px) 56px;
}

.topbar {
  height: 68px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 clamp(20px, 3.4vw, 52px);
  border-bottom: 1px solid hsl(var(--border));
  background: hsl(var(--card) / 0.72);
  backdrop-filter: blur(12px);
  position: sticky;
  top: 0;
  z-index: 10;
}

.panel {
  background: hsl(var(--card));
  border: 1px solid hsl(var(--card-border));
  border-radius: 10px;
  box-shadow: 0 1px 2px rgba(31, 45, 61, 0.03);
}

.panel-hover {
  transition:
    border-color 0.18s ease,
    transform 0.18s ease,
    box-shadow 0.18s ease;
}

.panel-hover:hover {
  border-color: hsl(var(--primary) / 0.45);
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(31, 45, 61, 0.07);
}

.animate-enter {
  animation: enter 0.35s ease both;
}

@keyframes enter {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.scanline {
  position: relative;
  overflow: hidden;
}

.scanline::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: -20%;
  width: 20%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.1),
    transparent
  );
  transform: skewX(-20deg);
  animation: scan 5s 1s infinite;
  pointer-events: none;
}

@keyframes scan {
  0%,
  70% {
    left: -20%;
  }

  100% {
    left: 120%;
  }
}

@media (max-width: 900px) {
  .sidebar {
    width: 72px;
    flex-basis: 72px;
    padding: 18px 10px;
  }

  .sidebar-label,
  .sidebar-copy,
  .sidebar-footer-copy,
  .sidebar-section {
    display: none;
  }

  .sidebar-brand {
    justify-content: center;
  }

  .nav-item {
    justify-content: center;
    padding: 11px;
  }

  .nav-item .nav-count {
    display: none;
  }
}

@media (max-width: 640px) {
  .app-shell {
    display: block;
  }

  .sidebar {
    width: 100%;
    height: 64px;
    padding: 10px 14px;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .sidebar-brand {
    flex: 1;
    justify-content: flex-start;
  }

  .sidebar-nav {
    display: flex;
    gap: 3px;
  }

  .sidebar-nav .nav-item {
    display: none;
  }

  .sidebar-nav .nav-item:nth-child(-n + 4) {
    display: flex;
  }

  .nav-item {
    padding: 9px;
  }

  .nav-item.active {
    background: hsl(var(--sidebar-accent));
  }

  .sidebar-bottom {
    display: none;
  }

  .topbar {
    position: static;
    height: 60px;
    padding: 0 16px;
  }

  .content-wrap {
    padding: 22px 16px 40px;
  }
}
